;-------------------------------------------------------------------------------
; BLSSNDH / DemOS - debug target > metafile build to speed up compilation
;-------------------------------------------------------------------------------

BLZSNDH.PRG		; name of executable program

.C [ -P -K -C -M -DblsUSEASM=1 -DblsBENCHMARK=0 -DDEMOS_OPTIMIZED=1]
.L [ ]
.S [ ]
=									; list of modules follows...

PCSTART.O        ; standard startup code

OUTPUT\BLSZIO.O
OUTPUT\BLZPLAY.O
OUTPUT\LOAD.O
OUTPUT\STANDARD.O
OUTPUT\SYSTEM.O
OUTPUT\TRACE.O

BLZSNDH\BUILD.C

PCSTDLIB.LIB        ; standard library

OUTPUT\BLZSNDH\THEMUZIK.O
